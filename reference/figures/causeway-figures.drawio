        </mxCell>
        <mxCell id="b3" value="104 matched by at least one recall net&#10;LEXICAL 96 &#183; STRUCTURAL 48 &#183; both 40" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=13;" vertex="1" parent="1">
