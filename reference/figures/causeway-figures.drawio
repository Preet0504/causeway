  <diagram name="Fig2-Grounding">
    <mxGraphModel dx="1100" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="g_t" value="Why the output can be trusted" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="g_s" value="Reasoning is adaptive; grounding is structural. Every call crosses one enforcement point." style="text;html=1;fontSize=12;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="42" width="760" height="20" as="geometry" />
        </mxCell>

        <mxCell id="g_orch" value="ORCHESTRATOR&#10;stage sequence, gates, fan-out ceilings" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="g_ag" value="SIX REASONING AGENTS&#10;strategist &#183; build-doctor &#183; adjudicator&#10;symptom &#183; synthesist &#183; path-tracer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="420" y="90" width="300" height="56" as="geometry" />
        </mxCell>
        <mxCell id="g_agn" value="one distinct QUESTION each,&#10;never a tool category" style="text;html=1;fontSize=10;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="740" y="100" width="200" height="30" as="geometry" />
        </mxCell>

        <mxCell id="g_mcp" value="MCP BOUNDARY &#8212; the only place enforcement lives" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8E8E8;strokeColor=#000000;strokeWidth=2;fontSize=13;fontStyle=1;verticalAlign=top;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="880" height="150" as="geometry" />
        </mxCell>
        <mxCell id="g_s1" value="1&#10;tool exists&#10;in catalog" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g_s2" value="2&#10;agent is&#10;permitted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="228" y="240" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g_s3" value="3&#10;input matches&#10;schema" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="376" y="240" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g_s4" value="4&#10;handler runs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="524" y="240" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g_s5" value="5&#10;output matches&#10;schema" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="672" y="240" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g_s6" value="6&#10;evidence id&#10;minted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;strokeColor=#000000;fontColor=#FFFFFF;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="820" y="240" width="100" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g_env" value="every response has one shape:  { ok, evidenceId, data | unknown }      an `unknown` is a SUCCESS carrying a reason, and is citable" style="text;html=1;fontSize=11;align=left;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="80" y="312" width="840" height="20" as="geometry" />
        </mxCell>

        <mxCell id="g_svc" value="DETERMINISTIC SERVICES&#10;JGit &#183; GitHub GraphQL &#183; SootUp &#183; JaCoCo &#183; containers &#183; metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="470" height="56" as="geometry" />
        </mxCell>
        <mxCell id="g_led" value="EVIDENCE LEDGER&#10;content-hashed id per payload" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="580" y="400" width="360" height="56" as="geometry" />
        </mxCell>

        <mxCell id="g_e1" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="g_orch" target="g_mcp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g_e2" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="g_ag" target="g_mcp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g_e3" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="g_mcp" target="g_svc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g_e4" style="edgeStyle=none;html=1;endArrow=block;strokeColor=#000000;" edge="1" parent="1" source="g_mcp" target="g_led"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="g_gt" value="TWO GUARANTEES THAT ARE PROPERTIES, NOT CONVENTIONS" style="text;html=1;fontSize=12;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="600" height="20" as="geometry" />
        </mxCell>
        <mxCell id="g_g1" value="An agent cannot assert what it did not retrieve.&#10;&#10;findings_record rejects any claim citing an evidence id the&#10;ledger never issued. Finding's constructor is private, so an&#10;unevidenced claim is not representable.&#10;&#10;Result on this run: 104 findings, 0 unbacked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="60" y="528" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="g_g2" value="A missing signal never becomes a number.&#10;&#10;Signal[A] = Known | Unknown(reason). There is no getOrElse,&#10;so a failed build cannot silently become 0.0 coverage.&#10;Reasons are a closed enum, aggregated into the run's&#10;honesty report.&#10;&#10;Notes carry note_ ids and are structurally uncitable." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="520" y="528" width="420" height="140" as="geometry" />
        </mxCell>

        <mxCell id="g_f" value="Schemas are the source of truth: the server refuses at startup to serve a tool with no schema, and four build gates keep catalog, permissions, handlers and responses in agreement." style="text;html=1;fontSize=11;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="880" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

