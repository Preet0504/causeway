        <mxCell id="r2" value="34 commits matched NO net.&#10;15 sampled at random as a control,&#10;the only way to measure what the&#10;filter missed." style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="830" y="250" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="r4" value="20 NOT_BUG_FIX, 1 UNDECIDED.&#10;Control net found 1 real fix that&#10;no net matched: it ships no test&#10;and cites no issue." style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="830" y="406" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="r5" value="0 rejected. Failures would be kept&#10;with admitted=false and a reason,&#10;never deleted, so selection bias&#10;stays measurable." style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="830" y="484" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="r6" value="1 bug ships no regression test,&#10;so rung 1 has nothing to port.&#10;Recorded T4_STATIC, not left null." style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="830" y="562" width="250" height="60" as="geometry" /></mxCell>
        <mxCell id="r7" value="15 OBSERVED &#183; 2 DISCONNECTED&#10;1 HYPOTHESIZED.&#10;4 steps unmeasurable, 0 unobserved." style="text;html=1;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="830" y="646" width="250" height="60" as="geometry" /></mxCell>

        <mxCell id="foot" value="Every claim above is bound to the tool call that produced it. 104 findings, 0 without evidence." style="text;html=1;fontSize=11;fontStyle=2;align=left;" vertex="1" parent="1">
