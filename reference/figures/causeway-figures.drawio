        <mxCell id="l2" value="recall nets&#10;(deterministic)" style="text;html=1;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="252" width="140" height="30" as="geometry" /></mxCell>
        <mxCell id="l3" value="cap + strategist&#10;AGENT" style="text;html=1;fontSize=11;align=left;fontStyle=1" vertex="1" parent="1"><mxGeometry x="20" y="330" width="140" height="30" as="geometry" /></mxCell>
