{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "causeway://schemas/tools/metrics_churn.json",
  "name": "metrics_churn",
  "title": "metrics.churn",
  "description": "Size and spread of a change. Pure function over a stored diff.",
  "x-causeway": {
    "class": "P",
    "module": "metrics",
    "permission": "allow",
    "agents": [],
    "unknownReasons": [
      "NotApplicable",
      "ToolUnavailable"
    ]
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "repoHandle": {
        "$ref": "causeway://schemas/_common.json#/$defs/repoHandle"
      },
      "fixSha": {
        "$ref": "causeway://schemas/_common.json#/$defs/commitId"
      }
    },
    "required": [
      "repoHandle",
      "fixSha"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "description": "Describes the `data` payload ONLY. The envelope { ok, evidenceId, data | unknown } is universal and enforced by modules/mcpserver.",
    "type": "object",
    "properties": {
      "linesAdded": {
        "type": "integer"
      },
      "linesDeleted": {
        "type": "integer"
      },
      "filesTouched": {
        "type": "integer"
      },
      "hunkCount": {
        "type": "integer"
      },
      "packagesTouched": {
        "type": "integer"
      },
      "testLocRatio": {
        "type": "number"
      }
    },
    "required": [
      "linesAdded",
      "linesDeleted",
      "filesTouched",
      "hunkCount",
      "packagesTouched"
    ],
    "additionalProperties": false
  }
}
