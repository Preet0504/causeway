{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "causeway://schemas/tools/export_run.json",
  "name": "export_run",
  "title": "export.run",
  "description": "Export a run to JSON so results survive a wiped database.",
  "x-causeway": {
    "class": "P",
    "module": "graphstore",
    "permission": "allow",
    "agents": [],
    "unknownReasons": [
      "ToolUnavailable",
      "NotApplicable"
    ]
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "runId": {
        "$ref": "causeway://schemas/_common.json#/$defs/runId"
      },
      "format": {
        "enum": [
          "json",
          "jsonl"
        ]
      },
      "outPath": {
        "type": "string"
      }
    },
    "required": [
      "runId"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "description": "Describes the `data` payload ONLY. The envelope { ok, evidenceId, data | unknown } is universal and enforced by modules/mcpserver.",
    "type": "object",
    "properties": {
      "path": {
        "type": "string"
      },
      "bugCount": {
        "type": "integer"
      },
      "byteSize": {
        "type": "integer"
      }
    },
    "required": [
      "path",
      "bugCount"
    ],
    "additionalProperties": false
  }
}
