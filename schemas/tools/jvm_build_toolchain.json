{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "causeway://schemas/tools/jvm_build_toolchain.json",
  "name": "jvm_build_toolchain",
  "title": "jvm.build_toolchain",
  "description": "Extract the declared toolchain from build files at a revision: build tool, source/target level, plugin config. Evidence for a BuildRecipe, not a guarantee it works.",
  "x-causeway": {
    "class": "E",
    "module": "jvm",
    "permission": "allow",
    "agents": [
      "build-doctor"
    ],
    "unknownReasons": [
      "NotApplicable",
      "ToolUnavailable"
    ]
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "repoHandle": {
        "$ref": "causeway://schemas/_common.json#/$defs/repoHandle"
      },
      "commit": {
        "$ref": "causeway://schemas/_common.json#/$defs/commitId"
      }
    },
    "required": [
      "repoHandle",
      "commit"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "description": "Describes the `data` payload ONLY. The envelope { ok, evidenceId, data | unknown } is universal and enforced by modules/mcpserver.",
    "type": "object",
    "properties": {
      "buildTool": {
        "$ref": "causeway://schemas/_common.json#/$defs/jvmBuildTool"
      },
      "declaredSourceLevel": {
        "type": "string"
      },
      "declaredTargetLevel": {
        "type": "string"
      },
      "wrapperPresent": {
        "type": "boolean"
      },
      "modules": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "markerFiles": {
        "type": "array",
        "items": {
          "$ref": "causeway://schemas/_common.json#/$defs/filePath"
        }
      }
    },
    "required": [
      "buildTool",
      "markerFiles"
    ],
    "additionalProperties": false
  }
}
