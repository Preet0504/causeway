{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "causeway://schemas/tools/forge_issue.json",
  "name": "forge_issue",
  "title": "forge.issue",
  "description": "Fetch one issue. Rate limiting returns Unknown(RateLimited) rather than throwing, so a throttled run degrades instead of collapsing.",
  "x-causeway": {
    "class": "E",
    "module": "forge",
    "permission": "allow",
    "agents": [
      "bugfix-adjudicator",
      "symptom-characterizer",
      "reproducer-synthesist",
      "path-tracer"
    ],
    "unknownReasons": [
      "RateLimited",
      "NotApplicable",
      "ToolUnavailable"
    ]
  },
  "inputSchema": {
    "type": "object",
    "properties": {
      "number": {
        "type": "integer"
      },
      "repoHandle": {
        "$ref": "causeway://schemas/_common.json#/$defs/repoHandle",
        "description": "The clone to derive owner/name from. Passed rather than asking for owner/name so an agent cannot query one repository while analysing another."
      }
    },
    "required": [
      "repoHandle",
      "number"
    ],
    "additionalProperties": false
  },
  "outputSchema": {
    "description": "Describes the `data` payload ONLY. The envelope { ok, evidenceId, data | unknown } is universal and enforced by modules/mcpserver.",
    "type": "object",
    "properties": {
      "number": {
        "type": "integer"
      },
      "title": {
        "type": "string"
      },
      "body": {
        "type": "string"
      },
      "state": {
        "type": "string"
      },
      "labels": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "author": {
        "type": "string"
      },
      "createdAt": {
        "type": "string"
      },
      "closedAt": {
        "type": "string"
      },
      "commentCount": {
        "type": "integer"
      },
      "participantCount": {
        "type": "integer"
      },
      "reopenedCount": {
        "type": "integer"
      }
    },
    "required": [
      "number",
      "title",
      "state",
      "labels",
      "createdAt"
    ],
    "additionalProperties": false
  }
}
