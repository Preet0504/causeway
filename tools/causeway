#!/usr/bin/env bash
# Causeway Mini's unified CLI launcher.
#
# Usage: tools/causeway <subcommand> [args...]
#
# Runs the compiled Causeway entry point directly via `java`, with no sbt
# involved at invocation time. sbt is a build tool, exactly right for
# active development, but the wrong layer for something invoked repeatedly
# that needs to behave predictably: fixed startup cost, fixed output, no
# build-server state to go stale. This script rebuilds and refreshes its
# cached classpath automatically, but only when a source file or build.sbt
# has actually changed since the cache was last written, sbt runs once per
# real change, never on every invocation.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# GitHub access, including the credential, belongs to this CLI layer, not
# to whatever chat command happens to invoke it: every subcommand that
# talks to GitHub reads GITHUB_TOKEN from its own process environment, and
# this is the one place that environment gets populated, so no command
# instructions need their own "source .env" step (or a raw curl call) ever
# again. Doesn't override a GITHUB_TOKEN already exported by the caller.
# Stripped through tr first: a .env saved with Windows CRLF line endings
# (easy to end up with when it's edited on Windows, even for a Linux/WSL
# run of this same script) leaves a trailing \r on each line that plain
# `. ./.env` chokes on with "command not found", confirmed live on a real
# Ubuntu/WSL run against this exact file.
if [ -f .env ]; then
  set -a
  # shellcheck disable=SC1091
  . <(tr -d '\r' < .env)
  set +a
fi

CLASSES_DIR="target/out/jvm/scala-3.3.6/causeway-mini/classes"
CACHE_FILE="target/causeway-classpath.txt"

stale=0
if [ ! -f "$CACHE_FILE" ] || [ ! -d "$CLASSES_DIR" ]; then
  stale=1
else
  newer="$(find src build.sbt -newer "$CACHE_FILE" 2>/dev/null || true)"
  if [ -n "$newer" ]; then
    stale=1
  fi
fi

if [ "$stale" -eq 1 ]; then
  echo "tools/causeway: source changed, rebuilding ..." >&2
  export PATH="$HOME/scoop/shims:$PATH"
  
  sbt -batch "compile" >&2
  sbt -batch "Compile/copyResources" >&2

  # `|| true`: grep -m1 exits right after its one match, which can send
  # sbt SIGPIPE for the output it still had queued to write; under
  # set -o pipefail that SIGPIPE'd exit status would otherwise abort this
  # script via set -e even though deps_raw already captured the match
  # grep printed before exiting. Confirmed live on real Linux/WSL, where
  # this actually triggers, unlike on Windows/Git Bash.
  deps_raw="$(sbt -batch "export Compile/dependencyClasspath" 2>/dev/null | grep -m1 '^List(' || true)"
  deps_raw="${deps_raw#List(}"
  deps_raw="${deps_raw%)}"
  if command -v cygpath >/dev/null 2>&1; then
    # Git Bash on Windows: java.exe is a native Windows binary and cannot
    # resolve MSYS-style /c/Users/... paths embedded in an argfile (Git
    # Bash only translates paths passed as literal command-line arguments,
    # not file contents), so convert the Coursier cache root to a real
    # Windows path, and use Windows' ; classpath separator.
    csr_cache="$(cygpath -w "$HOME/AppData/Local/Coursier/Cache/v1")"
    classes_path="$(cygpath -w "$CLASSES_DIR")"
    cp_sep=";"
  else
    # Real Linux/WSL: Coursier's own cache root (confirmed live against a
    # real Ubuntu/WSL run), and POSIX's : classpath separator. The old
    # Windows-only fallback here silently produced a broken classpath on
    # Linux, both the wrong cache path and the wrong separator, instead of
    # ever erroring loudly about it.
    csr_cache="${XDG_CACHE_HOME:-$HOME/.cache}/coursier/v1"
    classes_path="$CLASSES_DIR"
    cp_sep=":"
  fi
  deps_raw="${deps_raw//\$\{CSR_CACHE\}/$csr_cache}"
  deps_raw="${deps_raw//, /$cp_sep}"

  mkdir -p "$(dirname "$CACHE_FILE")"
  {
    echo "-cp"
    echo "$classes_path$cp_sep$deps_raw"
  } > "$CACHE_FILE"
  echo "tools/causeway: classpath cache refreshed" >&2
fi

exec java "@$CACHE_FILE" causeway.mini.Causeway "$@"
